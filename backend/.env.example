DATABASE_URL=postgresql://iae:iae@localhost:5432/iae
CLERK_SECRET_KEY=sk_test_...
PORT=4000
CORS_ORIGIN=http://localhost:3000
GROQ_API_KEY=
# Groq deprecated llama-3.3-70b-versatile in Aug 2026.
# openai/gpt-oss-20b is fast; openai/gpt-oss-120b is higher quality but slower.
GROQ_MODEL=openai/gpt-oss-20b

# Trigger.dev (required for AI generate jobs)
# Create a project at https://cloud.trigger.dev then copy:
# - Project ref (proj_...) into backend/trigger.config.ts (not an env var)
# - Secret key into TRIGGER_SECRET_KEY
# Also add DATABASE_URL, GROQ_API_KEY, and GROQ_MODEL in the Trigger.dev dashboard.
# Local: run `bun run trigger:dev` in a second terminal next to `bun run dev`.
TRIGGER_SECRET_KEY=

# Resend (required to send Invite emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=IAE <beth.t@example.com>
