DATABASE_URL=postgresql://iae:iae@localhost:5432/iae
CLERK_SECRET_KEY=sk_test_...
PORT=4000
# Bind address for the HTTP server. Use 0.0.0.0 in Docker/Render so the platform can reach the port.
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional comma-separated extra keys. Requests walk keys in round robin.
# GROQ_API_KEYS=
# Groq deprecated llama-3.3-70b-versatile in Aug 2026.
# openai/gpt-oss-120b is the default when GROQ_MODEL is unset.
# openai/gpt-oss-20b is faster if you want to override.
GROQ_MODEL=openai/gpt-oss-120b
# Small model used inside the generate job to classify the prompt as safe or not before diagram inference.
# openai/gpt-oss-20b is the default when GROQ_PROMPT_GUARD_MODEL is unset.
GROQ_PROMPT_GUARD_MODEL=openai/gpt-oss-20b

# Trigger.dev (required for AI generate jobs)
# Create a project at https://cloud.trigger.dev then copy:
# - Project ref (proj_...) into backend/trigger.config.ts (not an env var)
# - Secret key into TRIGGER_SECRET_KEY
# Also add DATABASE_URL, GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3, GROQ_MODEL, and GROQ_PROMPT_GUARD_MODEL in the Trigger.dev dashboard.
# Local: run `bun run trigger:dev` in a second terminal next to `bun run dev`.
TRIGGER_SECRET_KEY=

# Brevo SMTP (required to start the server and send Invite emails)
# Create an SMTP key in Brevo and verify the sender address in Brevo.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM=

# Upstash Redis (required in production to enforce AI rate limits)
# Create a database at https://console.upstash.com then copy REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog (optional). Tests inject a recorder and never call PostHog Cloud.
# Project API key from PostHog project settings. Host defaults to https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=
